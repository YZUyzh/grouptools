<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="referrer" content="no-referrer">
<meta name="color-scheme" content="light">
<title>电力小分队 · 期刊追踪</title>
<style>
:root{
  --bg:#f5f6f8;--surface:#fff;--ink:#283247;--secondary:#667085;
  --muted:#98a1b2;--line:#e8ebf0;--accent:#7463b9;
  --accent-hover:#6655a9;--soft:#f0edf8;--danger:#ba5261;
  --success:#42826e;--shadow:0 3px 18px rgba(30,40,60,.035)
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{
  background:var(--bg);color:var(--ink);
  font:14px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI",
  "PingFang SC","Microsoft YaHei",sans-serif
}
button,input,select{font:inherit}
button{cursor:pointer}
button:disabled{opacity:.45;cursor:not-allowed}
a{color:inherit}
[hidden]{display:none!important}
:focus-visible{outline:3px solid #d5ccef;outline-offset:3px}
button,input,select{-webkit-tap-highlight-color:transparent}
button{transition:background .15s}
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  gap:6px;min-height:34px;padding:6px 11px;border:1px solid #dce1e9;
  border-radius:8px;background:white;color:var(--secondary);
  font-size:12px;text-decoration:none;white-space:nowrap
}
.btn:hover:not(:disabled){background:#f8f9fb;color:var(--ink)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:white}
.btn.primary:hover:not(:disabled){background:var(--accent-hover)}
.btn.ghost{border-color:transparent;background:transparent}
.btn.active{background:var(--soft);border-color:#ded6ef;color:var(--accent)}
.btn.danger{color:var(--danger)}
.actions{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.shell{height:100vh;height:100dvh;display:grid;grid-template-columns:245px minmax(0,1fr)}
.sidebar{
  background:#fbfcfd;border-right:1px solid var(--line);padding:26px 15px 16px;
  display:flex;flex-direction:column;min-height:0
}
.brand{display:flex;align-items:center;gap:11px;padding:0 8px 26px}
.brand-mark{
  display:grid;place-items:center;width:38px;height:38px;border-radius:11px;
  color:var(--accent);background:var(--soft);font-size:23px
}
.brand strong{display:block;font-size:16px;font-weight:650}
.brand small{display:block;font-size:9px;letter-spacing:1.4px;color:var(--muted)}
.side-label{
  display:flex;align-items:center;justify-content:space-between;
  padding:0 9px 10px;font-size:11px;color:var(--muted)
}
#journals{overflow:auto;min-height:0;flex:1;scrollbar-width:thin}
.nav{
  display:flex;align-items:center;gap:8px;width:100%;text-align:left;
  min-height:53px;padding:9px;margin:4px 0;border:1px solid transparent;
  background:transparent;border-radius:8px;color:#737e91
}
.nav:hover{background:#f2f4f7}
.nav.active{background:var(--soft);color:var(--accent)}
.nav-copy{flex:1;min-width:0}
.nav-name{display:block;font-size:12px;font-weight:550}
.nav-sub{display:block;font-size:10px;color:var(--muted)}
.nav-count{font-size:10px;white-space:nowrap}
.side-foot{border-top:1px solid var(--line);margin-top:15px;padding:15px 9px 0}
.side-foot div{font-size:11px;color:#8893a4}
.side-foot small{font-size:9px;letter-spacing:.7px;color:#adb5c2}
main{
  min-width:0;min-height:0;display:flex;flex-direction:column;
  padding:27px 30px 15px;gap:17px
}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:14px}
.eyebrow{font-size:10px;letter-spacing:1.5px;color:var(--muted)}
h1{font-size:23px;font-weight:650;margin:3px 0 0}
.overview{display:flex;align-items:center;justify-content:space-between;gap:20px}
.overview p{font-size:12px;color:var(--secondary);margin:0}
.overview p span{font-size:11px;color:var(--muted)}
.metrics{display:flex;gap:23px}
.metric{white-space:nowrap}
.metric strong{font-size:21px;font-weight:600;color:#5e687b;margin-right:6px}
.metric span{font-size:10px;color:var(--muted)}
.notice{
  padding:10px 13px;background:var(--soft);border:1px solid #e3dcf0;
  color:#8272aa;border-radius:9px;font-size:11px;white-space:pre-line;
  overflow-wrap:anywhere
}
.notice.error{background:#fff4f5;border-color:#eedbe0;color:var(--danger)}
.workbench{
  flex:1;min-height:0;display:flex;flex-direction:column;background:white;
  border:1px solid var(--line);border-radius:14px;overflow:hidden;
  box-shadow:var(--shadow)
}
.toolbar{
  padding:16px 19px;display:flex;align-items:center;
  justify-content:space-between;gap:12px;flex-wrap:wrap
}
.searchbox{flex:1;min-width:200px;max-width:390px}
input,select{
  border:1px solid #e1e6ee;border-radius:8px;
  background:#fcfcfe;color:var(--ink);padding:9px 11px;font-size:12px
}
.searchbox input{width:100%;background:#f8f9fb}
input::placeholder{color:#a4acbb}
.tabs{display:flex;gap:3px;padding:3px;border-radius:7px;background:#f2f4f7}
.tabs button{border:0;background:none;padding:4px 10px;font-size:11px;color:#929bac;border-radius:5px}
.tabs button.active{background:white;color:var(--accent);box-shadow:0 1px 3px #25314b08}
.sectionbar{
  padding:0 19px 15px;border-bottom:1px solid var(--line);
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap
}
#journalTitle{font-size:14px;font-weight:600}
#journalSub{font-size:10px;color:var(--muted);margin-top:3px}
#scope{
  padding:10px 19px;font-size:11px;color:#8b7eaa;
  background:#fcfbfe;border-bottom:1px solid #eeeaf5;white-space:pre-line
}
#paperScroll{flex:1;min-height:0;overflow:auto;padding:7px 19px 19px;scrollbar-width:thin}
.paper{
  display:grid;grid-template-columns:39px minmax(0,1fr) auto;
  gap:12px;padding:19px 5px;border-bottom:1px solid #f0f2f6
}
.paper:hover{background:#fafbfe}
.paper.read .paper-title{color:#929bac}
.paper-icon{
  width:36px;height:39px;background:#f3f1f8;color:#9480b1;
  border-radius:9px;display:grid;place-items:center;font-size:13px
}
.paper-title{
  display:block;color:#455169;font-size:13px;font-weight:550;
  text-decoration:none;line-height:1.7;overflow-wrap:anywhere
}
.paper-title:hover{color:var(--accent)}
.authors{font-size:11px;color:#96a0b0;margin-top:5px}
.meta{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-top:8px}
.badge{font-size:10px;background:#f4f5f8;color:#8a94a5;padding:2px 7px;border-radius:5px}
.badge.purple{background:var(--soft);color:#8b79af}
.doi{font-size:10px;color:#a7aebc;overflow-wrap:anywhere;margin-top:6px}
.paper-actions{display:flex;gap:5px;align-items:flex-start}
.paper-actions .btn{font-size:11px;min-height:29px;padding:4px 7px}
#papers.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;padding-top:12px}
.grid .paper{
  display:flex;flex-direction:column;border:1px solid var(--line);
  border-radius:10px;padding:18px;gap:10px
}
.grid .paper-icon{display:none}
.grid .paper-actions{margin-top:auto;padding-top:8px}
.empty{text-align:center;padding:65px 20px;color:var(--muted);font-size:12px;white-space:pre-line}
.footer{
  display:flex;justify-content:space-between;gap:10px;padding:10px 19px;
  border-top:1px solid var(--line);font-size:10px;color:#a4adbc
}
dialog{
  width:min(610px,calc(100% - 26px));max-height:88vh;padding:24px;
  border:1px solid #e5e8ef;border-radius:15px;color:var(--ink);
  box-shadow:0 22px 90px #1e2a4430
}
dialog::backdrop{background:#18223461;backdrop-filter:blur(3px)}
dialog h2{font-size:19px;margin:0 0 6px}
.hint{font-size:11px;color:var(--muted);line-height:1.9;white-space:pre-line}
label{display:block;font-size:12px;color:#7e899c;margin:16px 0}
label input:not([type=checkbox]),label select{display:block;width:100%;margin-top:6px}
.check{display:flex;gap:8px;align-items:center}
input[type=checkbox]{accent-color:var(--accent)}
.dialog-actions{display:flex;justify-content:flex-end;gap:8px;border-top:1px solid var(--line);padding-top:16px;margin-top:20px}
#searchResults{max-height:290px;overflow:auto}
.result{padding:13px 0;border-bottom:1px solid var(--line);display:flex;gap:10px;align-items:center}
.result div{flex:1;min-width:0;font-size:12px}
.error-text{color:var(--danger);font-size:11px;white-space:pre-line}
#mobileMenu{display:none}
#backdrop{display:none}
@media(max-width:1100px){
  .shell{grid-template-columns:215px minmax(0,1fr)}
  main{padding:22px 18px 13px}
  .overview p{display:none}
  .paper{grid-template-columns:35px minmax(0,1fr)}
  .paper-actions{grid-column:2}
}
@media(max-width:680px){
  .shell{grid-template-columns:minmax(0,1fr)}
  .sidebar{
    position:fixed;inset:0 auto 0 0;width:260px;z-index:30;
    transform:translateX(-100%);transition:transform .18s
  }
  .sidebar.open{transform:translateX(0)}
  #backdrop.open{display:block;position:fixed;inset:0;background:#18223461;z-index:29;border:0}
  #mobileMenu{display:inline-flex}
  main{padding:15px 10px 9px;gap:12px}
  h1{font-size:20px}
  .topbar{align-items:flex-start}
  .topbar>.actions{justify-content:flex-end;gap:4px}
  .topbar .btn{font-size:10px;padding:5px 7px}
  .toolbar,.sectionbar{padding-left:12px;padding-right:12px}
  .searchbox{max-width:none;width:100%}
  #paperScroll{padding-left:11px;padding-right:11px}
  .paper{gap:9px}
  .metrics{gap:18px}
  .metric strong{font-size:18px}
  #scope{padding-left:12px;padding-right:12px}
  .footer span:last-child{display:none}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="shell">
  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true">ϟ</div>
      <div><strong>电力小分队</strong><small>JOURNAL TRACKER</small></div>
    </div>
    <div class="side-label">
      <span>我的期刊</span>
      <button class="btn ghost" id="addJournal" aria-label="添加期刊">＋</button>
    </div>
    <nav id="journals" aria-label="期刊导航"></nav>
    <div class="side-foot">
      <div>公开元数据 · 轻量追踪</div>
      <small>GROUPTOOLS / JOURNALS V1.0</small>
    </div>
  </aside>

  <button id="backdrop" aria-label="关闭期刊导航"></button>

  <main>
    <header class="topbar">
      <div class="actions">
        <button class="btn" id="mobileMenu" aria-label="打开期刊导航" aria-expanded="false">☰</button>
        <div>
          <div class="eyebrow">WORKSPACE / LITERATURE</div>
          <h1>期刊论文追踪</h1>
        </div>
      </div>
      <div class="actions">
        <button class="btn ghost" id="settingsBtn">设置</button>
        <button class="btn" id="refreshAll">更新全部</button>
        <button class="btn primary" id="refresh">更新当前</button>
        <button class="btn danger" id="stop" hidden>停止</button>
      </div>
    </header>

    <section class="overview">
      <p>跟踪期刊新一期，把时间留给阅读。<br>
        <span>公开书目信息 · DOI 直达 · 本地阅读记录</span>
      </p>
      <div class="metrics">
        <div class="metric"><strong id="metricJ">0</strong><span>期刊</span></div>
        <div class="metric"><strong id="metricP">0</strong><span>当前结果</span></div>
        <div class="metric"><strong id="metricF">0</strong><span>收藏</span></div>
      </div>
    </section>

    <div class="notice" id="notice" role="status">
      数据来自 Crossref。最新一期为元数据推断结果，请以出版社正式目录为准。
    </div>

    <section class="workbench">
      <div class="toolbar">
        <div class="searchbox">
          <input id="search" type="search" placeholder="搜索标题、作者、DOI"
                 aria-label="搜索当前范围论文">
        </div>
        <div class="actions">
          <div class="tabs" aria-label="阅读筛选">
            <button data-filter="all" class="active">全部</button>
            <button data-filter="unread">未读</button>
            <button data-filter="favorite">收藏</button>
          </div>
          <button class="btn" id="viewBtn">卡片视图</button>
          <button class="btn" id="exportBtn">导出 CSV</button>
        </div>
      </div>

      <div class="sectionbar">
        <div>
          <div id="journalTitle">请选择期刊</div>
          <div id="journalSub"></div>
        </div>
        <div class="actions">
          <select id="mode" aria-label="论文范围">
            <option value="latest">候选最新一期</option>
            <option value="issue">选择已识别期次</option>
            <option value="recent">最近发表</option>
          </select>
          <select id="issueSelect" aria-label="选择期次" hidden></select>
          <button class="btn ghost danger" id="removeJournal">移除期刊</button>
        </div>
      </div>

      <div id="scope"></div>
      <div id="paperScroll">
        <div id="papers"></div>
        <div id="empty" class="empty"></div>
      </div>

      <footer class="footer">
        <span id="footer">尚未更新</span>
        <span>简洁整理 · 专注研究</span>
      </footer>
    </section>
  </main>
</div>

<dialog id="addDialog">
  <h2>添加追踪期刊</h2>
  <p class="hint">推荐填写 ISSN 精确添加，也可以搜索期刊英文全名。请核对名称，避免选中同名刊物。</p>
  <form id="journalSearchForm">
    <label>期刊名称 / ISSN
      <input id="journalQuery" required maxlength="180"
             placeholder="例如 Applied Energy 或 0306-2619">
    </label>
    <div class="actions">
      <button class="btn primary" id="journalSearchBtn" type="submit">查询期刊</button>
    </div>
  </form>
  <p id="journalSearchStatus" class="hint" role="status"></p>
  <div id="searchResults"></div>
  <div class="dialog-actions">
    <button class="btn" data-close="addDialog">关闭</button>
  </div>
</dialog>

<dialog id="settingsDialog">
  <h2>抓取设置</h2>
  <p class="hint">扩大范围有助于发现较早上线、后来编入某期的论文，但仍不能保证覆盖出版社完整目录。</p>
  <form id="settingsForm">
    <label>扫描时间窗口
      <select id="monthsInput">
        <option value="6">最近 6 个月</option>
        <option value="12">最近 12 个月</option>
        <option value="24">最近 24 个月</option>
      </select>
    </label>
    <label>每本期刊最多扫描记录
      <select id="limitInput">
        <option value="1000">1,000 条</option>
        <option value="3000">3,000 条</option>
        <option value="5000">5,000 条</option>
      </select>
    </label>
    <label>联系邮箱（选填）
      <input id="emailInput" type="email" maxlength="180" placeholder="用于 Crossref mailto 参数">
    </label>
    <p class="hint">填写的邮箱会随接口请求发送给 Crossref；不需要 API 密钥。</p>
    <label class="check">
      <input id="autoInput" type="checkbox">
      页面打开时检查更新；保持打开时每 6 小时检查
    </label>
    <p class="hint">关闭网页后不会后台运行。定时检查可能受浏览器休眠影响。
所有期刊、缓存、收藏和已读记录仅保存在当前浏览器，不会同步到 GitHub。</p>
    <div class="dialog-actions">
      <button class="btn" type="button" data-close="settingsDialog">取消</button>
      <button class="btn primary" type="submit">保存设置</button>
    </div>
  </form>
</dialog>

<script>
"use strict";

const $ = id => document.getElementById(id);
const API = "https://api.crossref.org";
const PREFIX = "journal-tracker-v1:";
const TTL = 6 * 60 * 60 * 1000;
const ROWS = 200;

const DEFAULT_JOURNALS = [
  {issn:"0885-8950",name:"IEEE Transactions on Power Systems"},
  {issn:"1949-3053",name:"IEEE Transactions on Smart Grid"},
  {issn:"0306-2619",name:"Applied Energy"},
  {issn:"0360-5442",name:"Energy"},
  {issn:"0142-0615",name:"International Journal of Electrical Power & Energy Systems"}
];

let storageFailed = false;
function load(key, fallback){
  try{
    const raw = localStorage.getItem(PREFIX + key);
    return raw === null ? fallback : JSON.parse(raw);
  }catch{
    return fallback;
  }
}
function save(key, value){
  try{
    localStorage.setItem(PREFIX + key, JSON.stringify(value));
  }catch{
    storageFailed = true;
  }
}

let journals = load("journals", DEFAULT_JOURNALS);
if(!Array.isArray(journals)) journals = [...DEFAULT_JOURNALS];
journals = journals.filter(j =>
  j && typeof j.name === "string" && /^\d{4}-\d{3}[\dX]$/.test(j.issn)
);

let settings = {
  months:12, limit:3000, email:"", auto:true,
  ...load("settings", {})
};
if(![6,12,24].includes(Number(settings.months))) settings.months = 12;
if(![1000,3000,5000].includes(Number(settings.limit))) settings.limit = 3000;
settings.email = typeof settings.email === "string" ? settings.email : "";

let marks = load("marks", {});
if(!marks || typeof marks !== "object" || Array.isArray(marks)) marks = {};

let current = journals[0]?.issn || "";
let filter = "all";
let grid = false;
let busy = false;
let controller = null;
let searchController = null;
let cache = new Map();

function el(tag, className="", text){
  const node = document.createElement(tag);
  if(className) node.className = className;
  if(text !== undefined) node.textContent = text;
  return node;
}
function button(text, handler, className="btn"){
  const node = el("button", className, text);
  node.type = "button";
  node.onclick = handler;
  return node;
}
function message(text, error=false){
  $("notice").textContent = text;
  $("notice").classList.toggle("error", error);
}
function plain(value){
  // 只作为文本显示，不把接口内容插入 HTML。
  return String(value ?? "").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
}
function norm(value){return plain(value).toLowerCase()}
function dayNow(){return new Date().toISOString().slice(0,10)}
function dateParts(value){
  const p = value?.["date-parts"]?.[0];
  if(!Array.isArray(p) || !Number.isInteger(p[0]) || p[0] < 1000) return "";
  const out = [String(p[0])];
  if(Number.isInteger(p[[1]](#__1)) && p[[1]](#__1)>=1 && p[[1]](#__1)<=12){
    out.push(String(p[[1]](#__1)).padStart(2,"0"));
    if(Number.isInteger(p[[2]](#__2)) && p[[2]](#__2)>=1 && p[[2]](#__2)<=31)
      out.push(String(p[[2]](#__2)).padStart(2,"0"));
  }
  return out.join("-");
}
function dateKey(text){
  return text ? text + "-01-01".slice(0,10-text.length) : "";
}
function safeLink(value){
  try{
    const u = new URL(value);
    if(["https:","http:"].includes(u.protocol) && !u.username && !u.password)
      return u.href;
  }catch{}
  return "";
}
function normalizePaper(w){
  const doi = plain(w.DOI).toLowerCase();
  const published = dateParts(w.published) || dateParts(w.issued) ||
                    dateParts(w["published-online"]) || dateParts(w["published-print"]);
  const printDate = dateParts(w["published-print"]);
  return {
    id:doi,
    doi,
    title:plain(w.title?.[0]) || "未提供标题",
    authors:(w.author || []).map(a =>
      plain(a.name || [a.given,a.family].filter(Boolean).join(" "))
    ).filter(Boolean),
    journal:plain(w["container-title"]?.[0]),
    volume:plain(w.volume),
    issue:plain(w.issue),
    page:plain(w.page || w["article-number"]),
    published,
    printDate,
    onlineDate:dateParts(w["published-online"]),
    url:doi
      ? "https://doi.org/" + doi.split("/").map(encodeURIComponent).join("/")
      : safeLink(w.URL)
  };
}
function cacheFor(issn){
  if(cache.has(issn)) return cache.get(issn);
  const value = load("cache:" + issn, null);
  const valid = value && Array.isArray(value.items) && Number.isFinite(value.time)
    ? value : null;
  cache.set(issn, valid);
  return valid;
}
function fresh(issn){
  const c = cacheFor(issn);
  return c && Date.now()-c.time<TTL &&
    c.months===Number(settings.months) && c.limit===Number(settings.limit);
}
function markFor(p){
  return Object.hasOwn(marks,p.id) ? marks[p.id] : {};
}
function sleep(ms,signal){
  return new Promise((resolve,reject)=>{
    if(signal.aborted) return reject(new DOMException("已停止","AbortError"));
    const stop = ()=>{
      clearTimeout(timer);
      reject(new DOMException("已停止","AbortError"));
    };
    const timer = setTimeout(()=>{
      signal.removeEventListener("abort",stop);
      resolve();
    },ms);
    signal.addEventListener("abort",stop,{once:true});
  });
}

async function request(path, params, signal){
  const url = new URL(API + path);
  for(const [key,value] of Object.entries(params || {}))
    url.searchParams.set(key,value);
  if(settings.email.trim()) url.searchParams.set("mailto",settings.email.trim());

  for(let attempt=0; attempt<3; attempt++){
    if(signal.aborted) throw new DOMException("已停止","AbortError");
    const local = new AbortController();
    const relay = ()=>local.abort();
    signal.addEventListener("abort",relay,{once:true});
    const timer = setTimeout(()=>local.abort(),45000);
    let wait = 0;
    try{
      const response = await fetch(url,{
        signal:local.signal,
        credentials:"omit",
        headers:{Accept:"application/json"}
      });
      if(response.status===429 || response.status>=500){
        if(attempt===2) throw Error("接口暂时繁忙，HTTP "+response.status);
        const value = response.headers.get("Retry-After");
        const retryMs = value && /^\d+$/.test(value)
          ? Number(value)*1000 : value ? Date.parse(value)-Date.now() : 0;
        wait = Math.max(2000*(attempt+1),retryMs || 0);
        if(wait>120000) throw Error("接口要求较长等待，请稍后再更新。");
      }else{
        if(!response.ok)
          throw Error(response.status===404
            ? "Crossref 未找到该期刊，请核对 ISSN。"
            : "接口请求失败，HTTP "+response.status);
        const json = await response.json();
        if(!json.message) throw Error("接口返回格式异常。");
        return json.message;
      }
    }catch(error){
      if(signal.aborted) throw new DOMException("已停止","AbortError");
      if(error.name==="AbortError") throw Error("请求超过 45 秒，请检查网络后重试。");
      if(error instanceof TypeError)
        throw Error("网络请求失败。请检查网络、跨域限制或 Crossref 服务状态。");
      throw error;
    }finally{
      clearTimeout(timer);
      signal.removeEventListener("abort",relay);
    }
    await sleep(wait,signal);
  }
}

async function scanJournal(journal,signal){
  const start = new Date();
  start.setUTCDate(1);
  start.setUTCMonth(start.getUTCMonth()-Number(settings.months));
  const from = start.toISOString().slice(0,10);
  const until = dayNow();
  const limit = Number(settings.limit);
  const all = new Map();
  let cursor = "*", scanned = 0, total = 0, exhausted = false;

  while(scanned<limit){
    const rows = Math.min(ROWS,limit-scanned);
    message("正在更新 "+journal.name+"\n已扫描 "+scanned+" 条记录，请稍候…");
    const result = await request(
      "/journals/"+encodeURIComponent(journal.issn)+"/works",
      {
        filter:"type:journal-article,from-pub-date:"+from+",until-pub-date:"+until,
        sort:"published",
        order:"desc",
        rows,
        cursor,
        select:[
          "DOI","title","author","container-title","published",
          "published-print","published-online","issued",
          "volume","issue","page","article-number","URL"
        ].join(",")
      },
      signal
    );
    const items = result.items || [];
    total = Number(result["total-results"] || 0);
    scanned += items.length;

    for(const item of items){
      const p = normalizePaper(item);
      if(p.id) all.set(p.id,p);
    }
    if(items.length<rows || scanned>=total){
      exhausted = true;
      break;
    }
    const next = result["next-cursor"];
    if(!next) throw Error("接口未提供后续游标，未覆盖旧缓存。");
    cursor = next;
    if(scanned<limit) await sleep(450,signal);
  }

  if(signal.aborted) throw new DOMException("已停止","AbortError");
  const result = {
    time:Date.now(),from,until,months:Number(settings.months),limit,
    scanned,total,truncated:!exhausted,
    items:[...all.values()]
  };
  cache.set(journal.issn,result);
  save("cache:"+journal.issn,result);
  return result;
}

/*
  “最新一期”仅是候选：
  1. 只对有期号的记录分组，不把一个卷直接称为一期。
  2. 分组依据卷号+期号；没有卷号时增加年份，减少跨年混淆。
  3. 优先按印刷出版日期排序，否则参考公开的发表日期。
  4. 排除明确属于未来月份/日期的期次记录。
  5. 不声称覆盖出版社完整目录。
*/
function issueGroups(items){
  const groups = new Map();
  const today = dayNow();
  for(const p of items){
    if(!p.issue) continue;
    const date = p.printDate || p.published;
    if(!date || dateKey(date)>today) continue;
    const year = date.slice(0,4);
    const key = JSON.stringify([p.volume,p.issue,p.volume ? "" : year]);
    if(!groups.has(key)){
      groups.set(key,{
        key,volume:p.volume,issue:p.issue,
        year:p.volume ? "" : year,items:[],
        printRank:"",fallbackRank:""
      });
    }
    const g = groups.get(key);
    g.items.push(p);
    if(p.printDate && dateKey(p.printDate)>g.printRank)
      g.printRank = dateKey(p.printDate);
    if(dateKey(p.published)>g.fallbackRank)
      g.fallbackRank = dateKey(p.published);
  }
  return [...groups.values()].sort((a,b)=>{
    const dateOrder = (b.printRank||b.fallbackRank).localeCompare(a.printRank||a.fallbackRank);
    return dateOrder || b.volume.localeCompare(a.volume,undefined,{numeric:true}) ||
      b.issue.localeCompare(a.issue,undefined,{numeric:true});
  });
}
function issueLabel(g){
  return [
    g.year,
    g.volume ? "Vol. "+g.volume : "",
    "Issue "+g.issue
  ].filter(Boolean).join(" · ");
}
function scopeItems(){
  if(current==="favorites"){
    return Object.values(marks)
      .filter(m=>m.favorite && m.paper)
      .map(m=>m.paper);
  }
  const c = cacheFor(current);
  if(!c) return [];
  if($("mode").value==="recent") return c.items;

  const groups = issueGroups(c.items);
  const chosen = $("mode").value==="latest"
    ? groups[0] : groups.find(g=>g.key===$("issueSelect").value);
  return chosen?.items || [];
}
function visibleItems(){
  const query = norm($("search").value);
  return scopeItems().filter(p=>{
    const m = markFor(p);
    return (filter!=="unread" || !m.read) &&
      (filter!=="favorite" || m.favorite) &&
      (!query || norm([p.title,...p.authors,p.doi,p.journal].join(" ")).includes(query));
  }).sort((a,b)=>
    dateKey(b.published).localeCompare(dateKey(a.published)) ||
    a.page.localeCompare(b.page,undefined,{numeric:true}) ||
    a.title.localeCompare(b.title)
  );
}
function closeSidebar(){
  $("sidebar").classList.remove("open");
