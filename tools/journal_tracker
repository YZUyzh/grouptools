    update([journals.find(j=>j.issn===issn)]);
}
function renderSidebar(){
  const nav = $("journals");
  nav.replaceChildren();
  const favoriteCount = Object.values(marks).filter(m=>m.favorite).length;
  function add(id,name,sub,count){
    const b = button("",()=>chooseJournal(id),"nav"+(current===id?" active":""));
    const copy = el("span","nav-copy");
    copy.append(el("span","nav-name",name),el("span","nav-sub",sub));
    b.append(copy,el("span","nav-count",count));
    b.disabled = busy;
    if(current===id) b.setAttribute("aria-current","page");
    nav.append(b);
  }
  add("favorites","☆ 我的收藏","跨期刊保存的阅读清单",String(favoriteCount));
  for(const j of journals){
    const c = cacheFor(j.issn);
    add(j.issn,j.name,"ISSN "+j.issn,c ? String(c.items.length) : "未更新");
  }
  $("metricJ").textContent = journals.length;
  $("metricF").textContent = favoriteCount;
}
function renderScope(){
  const favorites = current==="favorites";
  const journal = journals.find(j=>j.issn===current);
  const c = favorites ? null : cacheFor(current);
  $("journalTitle").textContent = favorites ? "我的收藏" : journal?.name || "尚未添加期刊";
  $("journalSub").textContent = favorites
    ? "收藏保存论文快照，更新期刊不会自动移除收藏。"
    : journal ? "ISSN "+journal.issn+" · 数据源：Crossref" : "点击左侧 ＋ 添加期刊";

  $("mode").hidden = favorites || !journal;
  $("removeJournal").hidden = favorites || !journal;
  $("issueSelect").hidden = favorites || $("mode").value!=="issue";

  const groups = issueGroups(c?.items || []);
  const oldValue = $("issueSelect").value;
  $("issueSelect").replaceChildren();
  for(const g of groups)
    $("issueSelect").append(new Option(issueLabel(g)+" · "+g.items.length+" 篇",g.key));
  if(groups.some(g=>g.key===oldValue)) $("issueSelect").value = oldValue;

  if(favorites){
    $("scope").textContent = "这里展示你在当前浏览器保存的收藏，不限定最新一期。";
    $("footer").textContent = "本地收藏 · 可导出 CSV";
    return;
  }
  if(!c){
    $("scope").textContent = "尚未获取数据。点击“更新当前”查询该期刊。";
    $("footer").textContent = "尚未更新";
    return;
  }

  const mode = $("mode").value;
  const g = mode==="latest" ? groups[0] : groups.find(x=>x.key===$("issueSelect").value);
  let text;
  if(mode==="recent"){
    text = "最近发表：按 Crossref 发表日期排序，不代表同一期，也不等同于最新收录时间。";
  }else if(g){
    text = (mode==="latest" ? "候选最新一期（元数据推断）：" : "已识别期次：")+
      issueLabel(g)+"；找到 "+g.items.length+" 篇。";
  }else{
    text = "未识别出可用期号。该刊可能连续出版、未登记期号，或有效记录不足。请选择“最近发表”，不将最近若干篇冒充一期。";
  }
  text += "\n扫描范围："+c.from+" 至 "+c.until+
    "；扫描 "+c.scanned+" / 接口报告 "+c.total+" 条。";
  text += c.truncated
    ? " 已达到数量上限，候选期次或论文列表可能不完整。"
    : " 已遍历本次窗口返回的记录，但不保证出版社目录完整。";
  text += " 未来期次不纳入候选；元数据更新和日期精度可能影响判断。";
  if(c.months!==Number(settings.months) || c.limit!==Number(settings.limit))
    text += "\n设置已变更，当前仍为旧缓存，请重新更新。";
  $("scope").textContent = text;
  $("footer").textContent = "上次成功更新："+new Date(c.time).toLocaleString();
}
function toggleMark(p,key){
  const old = markFor(p);
  marks[p.id] = {...old,[key]:!old[key],paper:p};
  if(!marks[p.id].favorite && !marks[p.id].read) delete marks[p.id];
  save("marks",marks);
  renderSidebar();
  renderPapers();
  if(storageFailed) message("浏览器存储失败，变更仅在当前页面有效。请导出重要记录。",true);
}
function renderPapers(){
  const list = visibleItems();
  const container = $("papers");
  container.className = grid ? "grid" : "";
  const fragment = document.createDocumentFragment();

  for(const [i,p] of list.entries()){
    const m = markFor(p);
    const article = el("article","paper"+(m.read?" read":""));
    article.append(el("div","paper-icon",String(i+1).padStart(2,"0")));
    const info = el("div");
    const url = safeLink(p.url);
    const title = el(url ? "a" : "span","paper-title",p.title);
    if(url){
      title.href = url;
      title.target = "_blank";
      title.rel = "noopener noreferrer";
    }
    const authors = p.authors.length
      ? p.authors.slice(0,8).join(", ")+(p.authors.length>8?" 等":"")
      : "作者信息未提供";
    info.append(title,el("div","authors",authors));

    const meta = el("div","meta");
    meta.append(el("span","badge purple",p.journal || "期刊论文"));
    if(p.volume) meta.append(el("span","badge","Vol. "+p.volume));
    if(p.issue) meta.append(el("span","badge","Issue "+p.issue));
    if(p.published) meta.append(el("span","badge","发表 "+p.published));
    if(p.page) meta.append(el("span","badge","页码/编号 "+p.page));
    if(m.read) meta.append(el("span","badge","已读"));
    info.append(meta,el("div","doi","DOI: "+p.doi));
    article.append(info);

    const actions = el("div","paper-actions");
    const favorite = button(m.favorite?"★ 已收藏":"☆ 收藏",
      ()=>toggleMark(p,"favorite"),"btn"+(m.favorite?" active":""));
    favorite.setAttribute("aria-pressed",String(!!m.favorite));
    const read = button(m.read?"标为未读":"标为已读",()=>toggleMark(p,"read"));
    actions.append(favorite,read);
    article.append(actions);
    fragment.append(article);
  }

  container.replaceChildren(fragment);
  $("empty").hidden = list.length>0;
  $("empty").textContent = !scopeItems().length
    ? current==="favorites"
      ? "还没有收藏。\n点击论文旁的“☆ 收藏”即可加入。"
      : "当前范围暂无论文。\n可以更新数据、切换“最近发表”，或扩大扫描范围。"
    : "没有匹配当前搜索或阅读筛选的论文。";
  $("metricP").textContent = list.length;
  document.querySelectorAll("[data-filter]").forEach(b=>{
    const active = b.dataset.filter===filter;
    b.classList.toggle("active",active);
    b.setAttribute("aria-pressed",String(active));
  });
}
function render(){
  renderSidebar();
  renderScope();
  renderPapers();
  $("refresh").disabled = busy || !journals.some(j=>j.issn===current);
  $("refreshAll").disabled = busy || !journals.length;
  $("addJournal").disabled = busy;
  $("removeJournal").disabled = busy;
  $("settingsBtn").disabled = busy;
  $("stop").hidden = !busy;
}
async function update(list){
  list = list.filter(Boolean);
  if(busy || !list.length) return;
  busy = true;
  controller = new AbortController();
  render();
  const failures = [];
  let success = 0;
  let stopped = false;

  try{
    for(const journal of list){
      try{
        await scanJournal(journal,controller.signal);
        success++;
        render();
      }catch(error){
        if(error.name==="AbortError"){
          stopped = true;
          break;
        }
        failures.push(journal.name+"："+error.message);
      }
      if(controller.signal.aborted){
        stopped = true;
        break;
      }
    }
  }finally{
    busy = false;
    controller = null;
    render();
    let text = (stopped ? "已停止。" : "更新结束。")+
      "成功 "+success+" 本，失败 "+failures.length+" 本。"+
      "失败或中断的期刊保留原缓存。";
    if(failures.length) text += "\n"+failures.join("\n");
    if(storageFailed) text += "\n本地存储失败，部分结果仅在当前页面有效。";
    message(text,failures.length>0 || storageFailed);
  }
}

$("refresh").onclick = ()=>update([journals.find(j=>j.issn===current)]);
$("refreshAll").onclick = ()=>update([...journals]);
$("stop").onclick = ()=>{
  if(controller){
    controller.abort();
