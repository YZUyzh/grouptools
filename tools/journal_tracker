};
$("settingsForm").onsubmit = event=>{
  event.preventDefault();
  settings = {
    months:Number($("monthsInput").value),
    limit:Number($("limitInput").value),
    email:$("emailInput").value.trim(),
    auto:$("autoInput").checked
  };
  save("settings",settings);
  $("settingsDialog").close();
  render();
  message("设置已保存。点击“更新当前”或“更新全部”，按新范围重新获取数据。");
};

function csvCell(value){
  let text = String(value ?? "");
  // 防止电子表格把元数据当作公式执行。
  if(/^\s*[=+\-@\t\r]/.test(text)) text="'"+text;
  return '"'+text.replace(/"/g,'""')+'"';
}
$("exportBtn").onclick = ()=>{
  const items = visibleItems();
  if(!items.length){message("当前没有可导出的论文。");return}
  const rows = [
    ["标题","作者","期刊","卷","期","发表日期","印刷日期","页码或编号","DOI","链接","已读","收藏"],
    ...items.map(p=>[
      p.title,p.authors.join("; "),p.journal,p.volume,p.issue,
      p.published,p.printDate,p.page,p.doi,p.url,
      markFor(p).read?"是":"否",markFor(p).favorite?"是":"否"
    ])
  ];
  const text = "\uFEFF"+rows.map(r=>r.map(csvCell).join(",")).join("\r\n");
  const url = URL.createObjectURL(new Blob([text],{type:"text/csv;charset=utf-8"}));
  const a = el("a");
  a.href = url;
  a.download = "期刊论文-"+dayNow()+".csv";
  document.body.append(a);
  a.click();
  a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),10000);
  message("已导出当前筛选结果，共 "+items.length+" 篇。");
};

async function autoCheck(){
  if(!settings.auto || busy || document.hidden) return;
  if(document.querySelector("dialog[open]")) return;
  const stale = journals.filter(j=>!fresh(j.issn));
  if(stale.length) await update(stale);
}
// 每分钟检查缓存年龄；不会每分钟发起远端请求。
setInterval(autoCheck,60000);
document.addEventListener("visibilitychange",()=>{
  if(!document.hidden) autoCheck();
});

render();
if(location.protocol==="file:"){
  message("当前为本地文件模式。接口能否访问取决于浏览器与网络；推荐部署到 GitHub Pages。\n最新一期仅为元数据推断结果，请以出版社目录为准。");
}
if(settings.auto && journals.length) autoCheck();
