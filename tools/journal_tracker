$("issueSelect").onchange = ()=>{renderScope();renderPapers()};
document.querySelectorAll("[data-filter]").forEach(b=>{
  b.onclick = ()=>{filter=b.dataset.filter;renderPapers()};
});
$("viewBtn").onclick = ()=>{
  grid = !grid;
  $("viewBtn").textContent = grid ? "列表视图" : "卡片视图";
  renderPapers();
};
$("mobileMenu").onclick = ()=>{
  const open = !$("sidebar").classList.contains("open");
  $("sidebar").classList.toggle("open",open);
  $("backdrop").classList.toggle("open",open);
  $("mobileMenu").setAttribute("aria-expanded",String(open));
};
$("backdrop").onclick = closeSidebar;
document.addEventListener("keydown",e=>{if(e.key==="Escape") closeSidebar()});
document.querySelectorAll("[data-close]").forEach(b=>{
  b.onclick = ()=>$(b.dataset.close).close();
});

$("addJournal").onclick = ()=>{
  $("journalQuery").value = "";
  $("searchResults").replaceChildren();
  $("journalSearchStatus").textContent = "";
  $("addDialog").showModal();
};
$("addDialog").addEventListener("close",()=>{
  searchController?.abort();
});
function validISSN(value){
  if(!/^\d{4}-\d{3}[\dX]$/.test(value)) return false;
  const digits = value.replace("-","");
  const sum = [...digits].reduce((s,c,i)=>s+(c==="X"?10:Number(c))*(8-i),0);
  return sum%11===0;
}
$("journalSearchForm").onsubmit = async event=>{
  event.preventDefault();
  searchController?.abort();
  const localController = new AbortController();
  searchController = localController;
  $("journalSearchBtn").disabled = true;
  $("searchResults").replaceChildren();
  $("journalSearchStatus").textContent = "正在查询…";

  try{
    const query = $("journalQuery").value.trim();
    let issn = query.toUpperCase().replace(/^ISSN\s*:?\s*/i,"").replace(/\s/g,"");
    if(/^\d{7}[\dX]$/.test(issn)) issn=issn.slice(0,4)+"-"+issn.slice(4);
    const looksISSN = /^\d{4}-\d{3}[\dX]$/.test(issn);
    if(looksISSN && !validISSN(issn)) throw Error("ISSN 校验位不正确，请核对。");
    const response = looksISSN
      ? await request("/journals/"+encodeURIComponent(issn),{},localController.signal)
      : await request("/journals",{query,rows:10},localController.signal);
    const results = looksISSN ? [response] : response.items || [];

    for(const item of results){
      const types = item["issn-type"] || [];
      const id = (looksISSN ? issn : "") ||
        types.find(x=>x.type==="electronic")?.value ||
        item.ISSN?.[0];
      if(!id || !validISSN(id.toUpperCase())) continue;
      const normalizedID = id.toUpperCase();
      const name = plain(item.title) || normalizedID;
      const row = el("div","result");
      const text = el("div");
      text.append(el("strong","",name),el("div","hint","ISSN "+(item.ISSN || [id]).join(" / ")));
      const exists = journals.some(j=>j.issn===normalizedID);
      const add = button(exists?"已添加":"添加",()=>{
        if(journals.some(j=>j.issn===normalizedID)) return;
        journals.push({issn:normalizedID,name});
        save("journals",journals);
        $("addDialog").close();
        chooseJournal(normalizedID);
      },exists?"btn":"btn primary");
      add.disabled = exists;
      row.append(text,add);
      $("searchResults").append(row);
    }
    $("journalSearchStatus").textContent = $("searchResults").children.length
      ? "请选择正确期刊。不同 ISSN 可能属于同一本期刊的印刷版和电子版。"
      : "未找到可添加的期刊，请改用 ISSN 或完整英文刊名。";
  }catch(error){
    if(error.name!=="AbortError") $("journalSearchStatus").textContent=error.message;
  }finally{
    if(searchController===localController){
      $("journalSearchBtn").disabled = false;
      searchController = null;
    }
  }
};

$("removeJournal").onclick = ()=>{
  if(busy) return;
  const journal = journals.find(j=>j.issn===current);
  if(!journal || !confirm("移除期刊“"+journal.name+"”？已保存的收藏和已读记录将保留。")) return;
  journals = journals.filter(j=>j.issn!==current);
  save("journals",journals);
  current = journals[0]?.issn || "favorites";
  render();
};

$("settingsBtn").onclick = ()=>{
  $("monthsInput").value = settings.months;
  $("limitInput").value = settings.limit;
  $("emailInput").value = settings.email;
  $("autoInput").checked = !!settings.auto;
